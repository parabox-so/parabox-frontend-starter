# Parabox Frontend Environment Variables

# Next.js Public Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_SSE_URL=http://localhost:8080/events

# Clerk Authentication (Optional in Mock Mode)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Mock Auth Mode (true/false)
NEXT_PUBLIC_ENABLE_MOCK_AUTH=true

# Stripe Billing
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_stripe_placeholder
